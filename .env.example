# FSR-Stack — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# === Alternative: Composio.dev (skip the 4 lines below) ===
# If you connect Composio.dev MCP and authorize the apify, airtable, apollo,
# and instantly toolkits, you do NOT need APIFY_TOKEN, AIRTABLE_API_KEY, or
# INSTANTLY_API_KEY. The skills auto-detect Composio and route through it.
# Apollo OAuth (via claude.ai MCP) still works alongside either path.
# See SETUP.md section 1b for details.

# LinkedIn Outreach Pipeline Credentials

# Apify — LinkedIn scraping via Apify MCP server
# Get your token at: https://console.apify.com/account/integrations
# Free tier: $5/month credits (~50 scraped posts)
APIFY_TOKEN=your-apify-token-here

# Airtable — Lead storage via Airtable MCP server
# Create a PAT at: https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_API_KEY=your-airtable-pat-here

# Instantly.ai — Cold email campaigns via HTTP API v2
# Get your key at: Instantly dashboard > Settings > Integrations > API
# Paid plan required (starts $37/month)
INSTANTLY_API_KEY=your-instantly-api-key-here

# Apollo.io — Email enrichment
# Uses OAuth via the claude.ai-hosted Apollo MCP server.
# Connect it in Claude Code settings, no env var needed here.

# WARNING: Never commit this file with real values.
# The .gitignore already excludes .env — do not override that.
# Rotate any key you accidentally expose.
